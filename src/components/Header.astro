---
interface Props {
  activePage?: string;
}
const { activePage = '' } = Astro.props;

const links = [
  { href: '/how-it-works', label: 'How it works' },
  { href: '/features', label: 'Features' },
  { href: '/about', label: 'About' },
  { href: '/blog', label: 'Blog' },
  { href: '/connect', label: 'Connect' },
];
---

<header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-slate-100">
  <nav class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center">
      <img src="/header-logo.png" alt="Cartana" height="32" class="h-8 w-auto" />
    </a>

    <ul class="hidden md:flex items-center gap-8">
      {links.map(link => (
        <li>
          <a
            href={link.href}
            class={`text-sm font-medium transition-colors ${
              activePage === link.href
                ? 'text-teal-600 underline underline-offset-4'
                : 'text-slate-600 hover:text-slate-900'
            }`}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-3">
      <a
        href="https://cartana.app"
        class="hidden md:inline-flex items-center gap-1.5 bg-teal-600 hover:bg-teal-700 text-white text-sm font-semibold px-4 py-2 rounded-full transition-colors"
      >
        Try Cartana
      </a>
      <button
        id="menu-toggle"
        class="md:hidden p-2 rounded-lg text-slate-600 hover:bg-slate-100"
        aria-label="Open menu"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-100 bg-white px-6 py-4 flex flex-col gap-4">
    {links.map(link => (
      <a href={link.href} class="text-sm font-medium text-slate-700 hover:text-teal-600">{link.label}</a>
    ))}
    <a href="https://cartana.app" class="inline-flex justify-center bg-teal-600 text-white text-sm font-semibold px-4 py-2.5 rounded-full">
      Try Cartana
    </a>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
