---
const year = new Date().getFullYear();
---

<footer class="bg-slate-900 text-slate-400">
  <div class="max-w-6xl mx-auto px-6 py-16">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-10 mb-12">
      <div class="col-span-2 md:col-span-1">
        <a href="/" class="flex items-center mb-3">
          <img src="/header-logo.png" alt="Cartana" height="28" class="h-7 w-auto brightness-0 invert" />
        </a>
        <p class="text-sm leading-relaxed">Shopping intelligence for everyday life.</p>
      </div>

      <div>
        <h4 class="text-white text-sm font-semibold mb-4">Product</h4>
        <ul class="space-y-3 text-sm">
          <li><a href="/how-it-works" class="hover:text-white transition-colors">How it works</a></li>
          <li><a href="/features" class="hover:text-white transition-colors">Features</a></li>
          <li><a href="https://cartana.app" class="hover:text-white transition-colors">Try the app</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-white text-sm font-semibold mb-4">Company</h4>
        <ul class="space-y-3 text-sm">
          <li><a href="/about" class="hover:text-white transition-colors">About</a></li>
          <li><a href="/blog" class="hover:text-white transition-colors">Blog</a></li>
          <li><a href="/privacy" class="hover:text-white transition-colors">Privacy</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-white text-sm font-semibold mb-4">Stay in the loop</h4>
        <p class="text-sm mb-4">Get updates on new stores, features, and savings tips.</p>
        <a
          href="https://cartana.app"
          class="inline-flex items-center gap-1.5 bg-teal-600 hover:bg-teal-500 text-white text-sm font-medium px-4 py-2 rounded-full transition-colors"
        >
          Try Cartana free
        </a>
      </div>
    </div>

    <div class="border-t border-slate-800 pt-8 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs">
      <p>&copy; {year} Cartana. All rights reserved.</p>
      <div class="flex gap-6">
        <a href="/privacy" class="hover:text-white transition-colors">Privacy policy</a>
        <a href="/privacy#terms" class="hover:text-white transition-colors">Terms</a>
      </div>
    </div>
  </div>
</footer>
