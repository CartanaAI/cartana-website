---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  category?: string;
  readTime?: string;
}

const { title, description, pubDate, category = 'Article', readTime } = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://cartanaapp.com');

const formattedDate = pubDate.toLocaleDateString('en-US', {
  month: 'long', day: 'numeric', year: 'numeric'
});

const badgeClass =
  category === 'Savings' ? 'bg-green-100 text-green-700' :
  category === 'Guide'   ? 'bg-blue-50 text-blue-600' :
                           'bg-teal-50 text-teal-700';
---

<!doctype html>
<html lang="en" class="bg-white text-slate-900">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={`${title} — Cartana Blog`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={`${title} — Cartana Blog`} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://rsms.me/" />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
    <title>{title} — Cartana Blog</title>
  </head>
  <body class="antialiased">
    <!-- Header -->
    <header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-slate-100">
      <nav class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center">
          <img src="/header-logo.png" alt="Cartana" height="32" class="h-8 w-auto" />
        </a>
        <a href="/blog" class="text-sm text-slate-500 hover:text-slate-900 transition-colors">← All posts</a>
        <a href="https://cartana.app/search" class="hidden md:inline-flex items-center gap-1.5 bg-teal-600 hover:bg-teal-700 text-white text-sm font-semibold px-4 py-2 rounded-full transition-colors">
          Try Cartana
        </a>
      </nav>
    </header>

    <article>
      <!-- Post header -->
      <div class="bg-slate-50 pt-14 pb-12">
        <div class="max-w-3xl mx-auto px-6">
          <div class="flex items-center gap-3 mb-5">
            <span class={`text-xs font-semibold px-2.5 py-1 rounded-full ${badgeClass}`}>{category}</span>
            {readTime && <span class="text-xs text-slate-400">{readTime}</span>}
          </div>
          <h1 class="text-4xl font-bold text-slate-900 tracking-tight leading-tight mb-4">{title}</h1>
          <p class="text-slate-400 text-sm">{formattedDate}</p>
        </div>
      </div>

      <!-- Body -->
      <div class="max-w-3xl mx-auto px-6 py-12 post-body">
        <slot />
      </div>

      <!-- CTA -->
      <div class="bg-teal-600 py-16 text-center">
        <div class="max-w-xl mx-auto px-6">
          <h2 class="text-2xl font-bold text-white mb-3">Put this into practice.</h2>
          <p class="text-teal-100 mb-6">Compare prices across 60+ stores near you — free, no sign-in required.</p>
          <a href="https://cartana.app/search" class="inline-flex items-center gap-2 bg-white text-teal-700 font-semibold px-8 py-3.5 rounded-full hover:bg-teal-50 transition-colors">
            Try Cartana free
          </a>
        </div>
      </div>
    </article>

    <!-- Footer -->
    <footer class="bg-slate-900 text-slate-400">
      <div class="max-w-6xl mx-auto px-6 py-10 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs">
        <a href="/" class="flex items-center">
          <img src="/header-logo.png" alt="Cartana" height="24" class="h-6 w-auto brightness-0 invert" />
        </a>
        <p>&copy; {new Date().getFullYear()} Cartana. All rights reserved.</p>
        <div class="flex gap-6">
          <a href="/blog" class="hover:text-white transition-colors">Blog</a>
          <a href="/privacy" class="hover:text-white transition-colors">Privacy</a>
        </div>
      </div>
    </footer>

    <script type="text/javascript" async src="https://subscribe-forms.beehiiv.com/attribution.js"></script>
  </body>
</html>

<style>
  .post-body :global(h2) {
    font-size: 1.5rem;
    font-weight: 700;
    color: #0f172a;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    line-height: 1.3;
  }
  .post-body :global(h3) {
    font-size: 1.125rem;
    font-weight: 600;
    color: #0f172a;
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }
  .post-body :global(p) {
    color: #475569;
    line-height: 1.75;
    margin-bottom: 1.25rem;
  }
  .post-body :global(ul) {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
    color: #475569;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .post-body :global(ol) {
    list-style-type: decimal;
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
    color: #475569;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .post-body :global(li) {
    line-height: 1.75;
  }
  .post-body :global(strong) {
    font-weight: 600;
    color: #0f172a;
  }
  .post-body :global(a) {
    color: #0d9488;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .post-body :global(blockquote) {
    border-left: 3px solid #99f6e4;
    padding-left: 1rem;
    font-style: italic;
    color: #64748b;
    margin: 1.5rem 0;
  }
  .post-body :global(hr) {
    border: none;
    border-top: 1px solid #f1f5f9;
    margin: 2rem 0;
  }
  .post-body :global(table) {
    width: 100%;
    font-size: 0.875rem;
    border-collapse: collapse;
    margin-bottom: 1.5rem;
  }
  .post-body :global(th) {
    text-align: left;
    font-weight: 600;
    color: #0f172a;
    border-bottom: 2px solid #e2e8f0;
    padding: 0.5rem 1rem 0.5rem 0;
  }
  .post-body :global(td) {
    padding: 0.5rem 1rem 0.5rem 0;
    color: #475569;
    border-bottom: 1px solid #f1f5f9;
  }
</style>
