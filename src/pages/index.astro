---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
---

<Layout>
  <Header activePage="/" />

  <!-- HERO -->
  <section class="relative overflow-hidden bg-white pt-20 pb-28">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#f1f5f9_1px,transparent_1px),linear-gradient(to_bottom,#f1f5f9_1px,transparent_1px)] bg-[size:48px_48px] opacity-60 pointer-events-none"></div>

    <div class="relative max-w-6xl mx-auto px-6 flex flex-col lg:flex-row items-center gap-16">
      <!-- Copy -->
      <div class="flex-1 text-center lg:text-left">
        <div class="inline-flex items-center gap-2 bg-teal-50 text-teal-700 text-xs font-semibold px-3 py-1.5 rounded-full mb-6 border border-teal-100">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.09 6.43H21l-5.47 3.97 2.09 6.43L12 14.87l-5.62 3.96 2.09-6.43L3 8.43h6.91z"/></svg>
          2,400+ households on early access
        </div>
        <h1 class="text-5xl sm:text-6xl font-bold text-slate-900 leading-[1.1] tracking-tight mb-6">
          Shopping intelligence<br class="hidden sm:block" />
          for <span class="text-teal-600">everyday life.</span>
        </h1>
        <p class="text-xl text-slate-500 leading-relaxed max-w-lg mx-auto lg:mx-0 mb-8">
          Compare local prices. Build smarter carts.<br class="hidden sm:block" />
          Know where and when to buy.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center lg:justify-start">
          <a href="/early-access" class="inline-flex items-center justify-center gap-2 bg-teal-600 hover:bg-teal-700 text-white font-semibold px-6 py-3.5 rounded-full transition-colors text-base">
            Get early access
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/how-it-works" class="inline-flex items-center justify-center gap-2 text-slate-700 hover:text-slate-900 font-medium px-6 py-3.5 rounded-full border border-slate-200 hover:border-slate-300 transition-colors text-base">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="5,3 19,12 5,21"/></svg>
            See how it works
          </a>
        </div>
        <div class="mt-10 flex flex-wrap gap-5 justify-center lg:justify-start text-sm text-slate-500">
          <span class="flex items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-teal-500"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
            Local prices from nearby stores
          </span>
          <span class="flex items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-teal-500"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            Privacy first — your list is yours
          </span>
          <span class="flex items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-teal-500"><path d="M3 12a9 9 0 1018 0 9 9 0 00-18 0"/><path d="M12 7v5l3 3"/></svg>
            Fresh data, updated daily
          </span>
        </div>
      </div>

      <!-- Hero image -->
      <div class="flex-1 flex justify-center lg:justify-end">
        <img src="/hero-image.png" alt="Cartana app showing price comparison across nearby stores" class="w-full max-w-sm rounded-3xl shadow-2xl shadow-slate-900/20" />
      </div>
    </div>
  </section>

  <!-- SOCIAL PROOF BAR -->
  <section class="bg-white border-y border-slate-100 py-5">
    <div class="max-w-5xl mx-auto px-6">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 text-center">
        {[
          { value: '2,400+',  label: 'households on early access' },
          { value: '60+',     label: 'store chains tracked' },
          { value: '$1,000+', label: 'avg. annual overspend we help fix' },
          { value: 'Free',    label: 'to start, always' },
        ].map(s => (
          <div>
            <p class="text-2xl font-bold text-teal-600">{s.value}</p>
            <p class="text-xs text-slate-500 mt-0.5">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- THE PROBLEM -->
  <section class="bg-slate-50 py-24">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-16">
        <p class="text-teal-600 text-sm font-semibold uppercase tracking-wider mb-3">The problem</p>
        <h2 class="text-4xl font-bold text-slate-900 tracking-tight">Grocery data is broken.</h2>
        <p class="mt-4 text-lg text-slate-500 max-w-xl mx-auto">
          Prices change constantly. Stores show different prices. Product names never match. Most apps are built to sell you more, not help you spend better.
        </p>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {[
          { icon: 'store',  title: 'Store apps',    subtitle: 'Only show their prices.', desc: 'Locked to a single retailer. No comparison. No context.', accent: 'border-red-100 bg-red-50', badge: 'bg-red-100 text-red-700' },
          { icon: 'truck',  title: 'Delivery apps', subtitle: 'Show convenience.', desc: 'Marked-up prices, hidden fees, and algorithms tuned to maximize orders—not savings.', accent: 'border-orange-100 bg-orange-50', badge: 'bg-orange-100 text-orange-700' },
          { icon: 'target', title: 'Cartana',        subtitle: 'Shows the whole picture.', desc: 'Real prices across nearby stores. Smart search that understands products, not just keywords.', accent: 'border-teal-100 bg-teal-50', badge: 'bg-teal-100 text-teal-700' },
        ].map(card => (
          <div class={`rounded-2xl border p-6 ${card.accent}`}>
            <div class={`inline-flex items-center gap-2 px-2.5 py-1 rounded-full text-xs font-semibold mb-4 ${card.badge}`}>
              <Icon name={card.icon} size={13} /> {card.title}
            </div>
            <h3 class="text-lg font-semibold text-slate-900 mb-2">{card.subtitle}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{card.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SEARCH INTELLIGENCE -->
  <section class="py-24 bg-white">
    <div class="max-w-6xl mx-auto px-6 flex flex-col lg:flex-row items-center gap-16">
      <div class="flex-1 flex justify-center">
        <img src="/search-intelligence-image.png" alt="Cartana search intelligence showing category-aware product results" class="w-full max-w-sm rounded-3xl shadow-xl shadow-slate-900/15" />
      </div>
      <div class="flex-1 lg:max-w-md">
        <p class="text-teal-600 text-sm font-semibold uppercase tracking-wider mb-3">Search intelligence</p>
        <h2 class="text-4xl font-bold text-slate-900 tracking-tight mb-5">Search that actually understands products.</h2>
        <p class="text-lg text-slate-500 leading-relaxed mb-8">
          Type "Cheese" and Cartana shows you Shredded, Block, Sliced, Snacks — not just a keyword match. We group by type, form, flavor, and more.
        </p>
        <ul class="space-y-4">
          {[
            'Category-aware search — no exact names required',
            'Form & format recognition (sliced vs block vs shredded)',
            'Unit price comparisons across stores',
            'Smart results ranked by value, not ads',
          ].map(point => (
            <li class="flex items-start gap-3 text-sm text-slate-700">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="shrink-0 mt-0.5 text-teal-600" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
              {point}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- SMART CART -->
  <section class="bg-slate-50 py-24">
    <div class="max-w-6xl mx-auto px-6 flex flex-col lg:flex-row-reverse items-center gap-16">
      <div class="flex-1 flex justify-center">
        <div class="w-full max-w-sm space-y-3">
          <div class="bg-white rounded-3xl border border-slate-200 shadow-lg p-5">
            <div class="flex items-center justify-between mb-4">
              <h4 class="font-semibold text-slate-900">My Cart</h4>
              <span class="text-xs text-slate-500">14 items</span>
            </div>
            {[
              { name: 'Eggs', store: 'Walgreens', price: '$1.99' },
              { name: 'Milk, 2% Gallon', store: 'West Side Market', price: '$3.29' },
              { name: 'Chicken Breasts (2 lbs)', store: 'Target', price: '$6.49' },
            ].map(item => (
              <div class="flex items-center gap-3 py-2.5 border-b border-slate-50 last:border-0">
                <div class="w-8 h-8 bg-slate-100 rounded-lg flex items-center justify-center shrink-0 text-slate-400"><Icon name="package" size={15} /></div>
                <div class="flex-1 min-w-0">
                  <p class="text-xs font-medium text-slate-800 leading-tight">{item.name}</p>
                  <p class="text-[11px] text-slate-400">{item.store}</p>
                </div>
                <span class="text-sm font-semibold text-slate-900 shrink-0">{item.price}</span>
              </div>
            ))}
          </div>
          <div class="space-y-2.5">
            {[
              { label: 'Best Price', sublabel: 'Save the most money', price: '$48.22', note: 'You save $12.37', accent: 'border-teal-200 bg-teal-50', bar: 'bg-teal-600' },
              { label: 'Fewest Stores', sublabel: 'Shop in fewer places', price: '$53.91', note: '2 stores', accent: 'border-slate-200 bg-white', bar: 'bg-slate-300' },
              { label: 'Best Convenience', sublabel: 'Shortest drive', price: '$55.18', note: 'Closest route', accent: 'border-slate-200 bg-white', bar: 'bg-slate-300' },
            ].map(mode => (
              <div class={`rounded-2xl border p-4 flex items-center gap-4 ${mode.accent}`}>
                <div class={`w-2 h-10 rounded-full ${mode.bar} shrink-0`}></div>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-semibold text-slate-900">{mode.label}</p>
                  <p class="text-xs text-slate-500">{mode.sublabel}</p>
                </div>
                <p class="text-lg font-bold text-slate-900 shrink-0">{mode.price}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
      <div class="flex-1 lg:max-w-md">
        <p class="text-teal-600 text-sm font-semibold uppercase tracking-wider mb-3">Smart cart</p>
        <h2 class="text-4xl font-bold text-slate-900 tracking-tight mb-5">One cart. Smarter every time.</h2>
        <p class="text-lg text-slate-500 leading-relaxed mb-8">
          Add items and let Cartana optimize it. Choose what matters — lowest total, fewest stops, or closest stores.
        </p>
        <a href="/features" class="inline-flex items-center gap-2 text-teal-600 font-semibold text-sm hover:gap-3 transition-all">
          See all features
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- PRICE TRACKING -->
  <section class="py-24 bg-white">
    <div class="max-w-6xl mx-auto px-6 flex flex-col lg:flex-row items-center gap-16">
      <div class="flex-1 flex justify-center">
        <div class="w-full max-w-sm bg-white rounded-3xl border border-slate-200 shadow-xl p-6">
          <div class="flex items-start gap-4 mb-6">
            <div class="w-14 h-14 bg-slate-100 rounded-2xl flex items-center justify-center shrink-0 text-slate-400"><Icon name="package" size={22} /></div>
            <div>
              <h4 class="font-semibold text-slate-900">Tide Pods, 81 ct</h4>
              <p class="text-sm text-slate-500">Laundry Detergent</p>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3 mb-6">
            <div class="bg-teal-50 rounded-2xl p-4 border border-teal-100">
              <p class="text-xs text-teal-600 font-medium mb-1">Current price</p>
              <p class="text-2xl font-bold text-slate-900">$18.99</p>
            </div>
            <div class="bg-slate-50 rounded-2xl p-4 border border-slate-100">
              <p class="text-xs text-slate-500 font-medium mb-1">Typical price</p>
              <p class="text-2xl font-bold text-slate-400 line-through">$24.99</p>
            </div>
          </div>
          <div class="bg-green-50 border border-green-100 rounded-xl px-4 py-2.5 mb-6 flex items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="text-green-600" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
            <span class="text-sm font-semibold text-green-700">34% below average</span>
          </div>
          <div>
            <p class="text-xs text-slate-500 font-medium mb-3">Price history (90 days)</p>
            <svg viewBox="0 0 280 60" class="w-full">
              <defs>
                <linearGradient id="sparkGrad" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#14b8a6" stop-opacity="0.2"/>
                  <stop offset="100%" stop-color="#14b8a6" stop-opacity="0"/>
                </linearGradient>
              </defs>
              <path d="M0,45 C20,42 40,50 60,48 C80,46 100,30 120,32 C140,34 160,44 180,40 C200,36 220,20 240,15 C250,12 265,10 280,8" stroke="#14b8a6" stroke-width="2.5" fill="none" stroke-linecap="round"/>
              <path d="M0,45 C20,42 40,50 60,48 C80,46 100,30 120,32 C140,34 160,44 180,40 C200,36 220,20 240,15 C250,12 265,10 280,8 L280,60 L0,60 Z" fill="url(#sparkGrad)"/>
              <circle cx="280" cy="8" r="4" fill="#0d9488"/>
            </svg>
          </div>
        </div>
      </div>
      <div class="flex-1 lg:max-w-md">
        <p class="text-teal-600 text-sm font-semibold uppercase tracking-wider mb-3">Price tracking</p>
        <h2 class="text-4xl font-bold text-slate-900 tracking-tight mb-5">Know when to buy.</h2>
        <p class="text-lg text-slate-500 leading-relaxed mb-8">
          Watch prices on the items your household buys regularly. Cartana tracks trends so you can spot deals, avoid overpaying, and buy at the right time.
        </p>
        <ul class="space-y-4">
          {[
            'Save products to your watchlist',
            'Price trend graphs over 30, 60, and 90 days',
            '"Below average" signals when prices dip',
            'Know before you shop, not after',
          ].map(point => (
            <li class="flex items-start gap-3 text-sm text-slate-700">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="shrink-0 mt-0.5 text-teal-600" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
              {point}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- TRUST -->
  <section class="py-24 bg-slate-50">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-16">
        <p class="text-teal-600 text-sm font-semibold uppercase tracking-wider mb-3">Trust & transparency</p>
        <h2 class="text-4xl font-bold text-slate-900 tracking-tight">Shopping recommendations should be explainable.</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { icon: 'search',    title: 'Transparent sourcing', desc: 'Every price shows which store, which date, and whether it was verified.' },
          { icon: 'ban',       title: 'No hidden markups', desc: 'We do not add fees. What you see is what the store charges.' },
          { icon: 'lock',      title: 'Your list stays yours', desc: 'Your grocery list and habits are never sold or shared with advertisers.' },
          { icon: 'bar-chart', title: 'Explained suggestions', desc: 'Every recommendation comes with the reasoning behind it. No black boxes.' },
        ].map(card => (
          <div class="bg-white rounded-2xl p-6 border border-slate-100">
            <div class="w-10 h-10 bg-teal-50 border border-teal-100 rounded-xl flex items-center justify-center mb-4 text-teal-600"><Icon name={card.icon} size={20} /></div>
            <h3 class="font-semibold text-slate-900 mb-2">{card.title}</h3>
            <p class="text-sm text-slate-500 leading-relaxed">{card.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ROADMAP -->
  <section class="py-24 bg-white">
    <div class="max-w-6xl mx-auto px-6 flex flex-col lg:flex-row items-center gap-16">
      <div class="flex-1 lg:max-w-md">
        <p class="text-teal-600 text-sm font-semibold uppercase tracking-wider mb-3">Where we're going</p>
        <h2 class="text-4xl font-bold text-slate-900 tracking-tight mb-5">
          Today: shopping intelligence.<br />
          <span class="text-teal-600">Tomorrow: household intelligence.</span>
        </h2>
        <p class="text-lg text-slate-500 leading-relaxed">
          We are building the infrastructure for real households — not just a better grocery app, but a system that understands what your household needs, when to buy it, and where to find it best.
        </p>
      </div>
      <div class="flex-1 flex justify-center">
        <div class="w-full max-w-xs space-y-2">
          {[
            { label: 'Search',              status: 'live',   icon: 'search' },
            { label: 'Smart Cart',          status: 'live',   icon: 'cart' },
            { label: 'Price Tracking',      status: 'live',   icon: 'trending-up' },
            { label: 'Recipe Planning',     status: 'coming', icon: 'utensils' },
            { label: 'Household Budgeting', status: 'coming', icon: 'wallet' },
            { label: 'Autonomous Shopping', status: 'future', icon: 'sparkles' },
          ].map(item => (
            <div class={`flex items-center gap-4 rounded-2xl px-4 py-3.5 border ${item.status === 'live' ? 'bg-teal-50 border-teal-100' : item.status === 'coming' ? 'bg-slate-50 border-slate-100' : 'bg-white border-dashed border-slate-200'}`}>
              <div class={`w-9 h-9 rounded-xl flex items-center justify-center shrink-0 ${item.status === 'live' ? 'bg-teal-100 text-teal-700' : item.status === 'coming' ? 'bg-slate-100 text-slate-500' : 'bg-slate-50 text-slate-400'}`}><Icon name={item.icon} size={16} /></div>
              <span class={`flex-1 text-sm font-medium ${item.status === 'live' ? 'text-slate-900' : 'text-slate-500'}`}>{item.label}</span>
              <span class={`text-xs font-semibold px-2.5 py-1 rounded-full ${item.status === 'live' ? 'bg-teal-600 text-white' : item.status === 'coming' ? 'bg-slate-200 text-slate-600' : 'bg-slate-100 text-slate-400'}`}>
                {item.status === 'live' ? 'Live' : item.status === 'coming' ? 'Coming soon' : 'Future'}
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="bg-teal-600 py-24">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <p class="text-teal-200 text-sm font-semibold uppercase tracking-wider mb-4">Join 2,400+ households</p>
      <h2 class="text-5xl font-bold text-white tracking-tight mb-5">Smarter shopping starts here.</h2>
      <p class="text-xl text-teal-100 mb-10 max-w-lg mx-auto">Get early access, influence the roadmap, and be first to unlock Price Alerts when they launch.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/early-access" class="inline-flex items-center justify-center gap-2 bg-white text-teal-700 font-semibold px-8 py-4 rounded-full hover:bg-teal-50 transition-colors text-lg">
          Get early access — it's free
        </a>
        <a href="https://cartana.app" class="inline-flex items-center justify-center gap-2 text-white border border-teal-400 hover:border-white font-medium px-8 py-4 rounded-full transition-colors text-lg">
          Try the app now
        </a>
      </div>
      <p class="mt-6 text-sm text-teal-200">No credit card. No commitment. Cancel anytime.</p>
    </div>
  </section>

  <Footer />
</Layout>
