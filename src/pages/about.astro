---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
---

<Layout
  title="About Cartana — Shopping intelligence built for households"
  description="Cartana exists to help people spend less, waste less, and make more informed shopping decisions every day."
>
  <Header activePage="/about" />

  <!-- HERO -->
  <section class="bg-white pt-20 pb-24">
    <div class="max-w-6xl mx-auto px-6 flex flex-col lg:flex-row items-center gap-16">
      <div class="flex-1 max-w-xl">
        <p class="text-teal-600 text-sm font-semibold uppercase tracking-wider mb-4">About Cartana</p>
        <h1 class="text-5xl font-bold text-slate-900 tracking-tight leading-tight mb-6">
          Built for shoppers.<br />Focused on what matters.
        </h1>
        <p class="text-lg text-slate-500 leading-relaxed mb-8">
          We help people spend less, waste less, and make more informed shopping decisions—every day.
        </p>
        <div class="bg-teal-50 border border-teal-100 rounded-2xl px-6 py-5 flex items-start gap-4">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0d9488" stroke-width="2" class="shrink-0 mt-0.5"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
          <p class="text-sm text-slate-700 leading-relaxed">
            Every purchase is a decision. We're here to help you make better ones.
          </p>
        </div>
      </div>
      <div class="flex-1 flex justify-center lg:justify-end">
        <img
          src="/hero-image.png"
          alt="Cartana app showing price comparison across nearby stores"
          class="w-full max-w-sm rounded-3xl shadow-2xl shadow-slate-900/20"
        />
      </div>
    </div>
  </section>

  <!-- OUR STORY -->
  <section class="bg-slate-50 py-24">
    <div class="max-w-6xl mx-auto px-6 flex flex-col lg:flex-row items-center gap-16">
      <div class="flex-1 bg-teal-50 rounded-3xl overflow-hidden aspect-[4/3] flex items-center justify-center border border-teal-100">
        <div class="text-center p-12">
          <Icon name="cart" size={56} class="mb-4 text-teal-400 mx-auto" />
          <p class="text-teal-700 font-medium text-sm">Shopping for your household</p>
        </div>
      </div>
      <div class="flex-1 lg:max-w-lg">
        <p class="text-teal-600 text-sm font-semibold uppercase tracking-wider mb-3">Our story</p>
        <h2 class="text-4xl font-bold text-slate-900 tracking-tight mb-6">Shopping has become harder than it should be.</h2>
        <div class="space-y-4 text-slate-500 leading-relaxed">
          <p>
            Consumers are expected to compare prices across multiple stores, keep track of promotions, plan meals, manage budgets, remember what they have at home, and somehow avoid wasting food along the way.
          </p>
          <p>
            Most tools only solve a small piece of that problem. Some help you order groceries. Others help you make a list. Some offer coupons. But very few help people understand the full picture.
          </p>
          <p class="text-slate-700 font-medium">
            We built Cartana to change that. Because shopping shouldn't feel like guesswork.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT WE BELIEVE -->
  <section class="bg-white py-24">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-16">
        <p class="text-teal-600 text-sm font-semibold uppercase tracking-wider mb-3">What we believe</p>
        <h2 class="text-4xl font-bold text-slate-900 tracking-tight">Better shopping starts with better information.</h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        {[
          {
            icon: 'dollar',
            title: 'Information should save people money.',
            desc: 'Clear, accurate pricing and product information helps households make smarter decisions.',
          },
          {
            icon: 'scale',
            title: "Convenience shouldn't sacrifice transparency.",
            desc: "We surface the real tradeoffs so you can choose what's right for you.",
          },
          {
            icon: 'leaf',
            title: 'Better planning creates less waste.',
            desc: 'Smarter lists and insights help households buy what they need and use what they buy.',
          },
          {
            icon: 'shield',
            title: 'Technology should work quietly.',
            desc: 'The best tools just make your life easier. No noise, no overwhelm.',
          },
        ].map(b => (
          <div class="flex flex-col items-center text-center">
            <div class="w-14 h-14 bg-teal-50 border border-teal-100 rounded-2xl flex items-center justify-center mb-5 text-teal-600">
              <Icon name={b.icon} size={22} />
            </div>
            <h3 class="font-bold text-slate-900 text-sm mb-3 leading-snug">{b.title}</h3>
            <p class="text-sm text-slate-500 leading-relaxed">{b.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- OUR VISION -->
  <section class="bg-slate-50 py-24">
    <div class="max-w-6xl mx-auto px-6 flex flex-col lg:flex-row items-center gap-16">
      <div class="flex-1 lg:max-w-md">
        <p class="text-teal-600 text-sm font-semibold uppercase tracking-wider mb-3">Our vision</p>
        <h2 class="text-4xl font-bold text-slate-900 tracking-tight mb-6">
          A future where shopping is simple, smart, and built around you.
        </h2>
        <p class="text-slate-500 leading-relaxed">
          Today, we focus on groceries and household essentials. Tomorrow, we believe these same principles can help people make better purchasing decisions everywhere.
        </p>
      </div>
      <div class="flex-1">
        <div class="grid grid-cols-2 gap-4">
          {[
            { icon: 'cart',        label: 'Smarter decisions' },
            { icon: 'wallet',      label: 'More savings' },
            { icon: 'leaf',        label: 'Less waste' },
            { icon: 'heart',       label: 'More time for what matters' },
          ].map(v => (
            <div class="bg-white rounded-2xl border border-slate-200 p-6 flex flex-col items-center text-center shadow-sm">
              <Icon name={v.icon} size={28} class="mb-3 text-teal-600" />
              <p class="text-sm font-semibold text-slate-800 leading-snug">{v.label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- WHY CARTANA -->
  <section class="bg-white py-24">
    <div class="max-w-6xl mx-auto px-6 flex flex-col lg:flex-row items-start gap-16">
      <div class="flex-1 lg:max-w-sm">
        <p class="text-teal-600 text-sm font-semibold uppercase tracking-wider mb-3">Why Cartana</p>
        <h2 class="text-4xl font-bold text-slate-900 tracking-tight mb-6">We're on your side.</h2>
        <p class="text-slate-500 leading-relaxed">
          We're not here to push more products. We're here to give you the clarity, tools, and confidence to shop better—for your household, your budget, and your future.
        </p>
      </div>
      <div class="flex-1">
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
          {[
            { icon: 'store',          label: 'Compare local prices' },
            { icon: 'search',         label: 'Discover better alternatives' },
            { icon: 'cart',           label: 'Build smarter carts' },
            { icon: 'bar-chart',      label: 'Track what matters' },
            { icon: 'trending-down',  label: 'Reduce unnecessary spending' },
            { icon: 'recycle',        label: 'Reduce household waste' },
          ].map(f => (
            <div class="bg-slate-50 rounded-2xl border border-slate-100 p-5 flex flex-col items-center text-center">
              <Icon name={f.icon} size={22} class="mb-3 text-teal-600" />
              <p class="text-xs font-semibold text-slate-700 leading-snug">{f.label}</p>
            </div>
          ))}
        </div>
        <p class="text-slate-400 text-sm mt-8 text-center">
          Because every dollar saved matters. And every purchase is a decision worth understanding.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-teal-800 py-20">
    <div class="max-w-4xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-8">
      <div>
        <h2 class="text-3xl font-bold text-white mb-2">Ready to shop smarter?</h2>
        <p class="text-teal-200 text-lg">Join thousands of households already saving time, money, and stress with Cartana.</p>
      </div>
      <div class="flex gap-3 shrink-0">
        <a
          href="https://cartana.app"
          class="inline-flex items-center bg-white text-teal-800 font-semibold text-sm px-6 py-3 rounded-full hover:bg-teal-50 transition-colors"
        >
          Try Cartana
        </a>
        <a
          href="https://cartana.app"
          class="inline-flex items-center border border-white/40 text-white font-semibold text-sm px-6 py-3 rounded-full hover:bg-white/10 transition-colors"
        >
          Join Early Access
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
