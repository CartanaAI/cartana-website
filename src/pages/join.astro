---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Join Cartana — Early Access"
  description="Get early access to Cartana. Compare grocery prices across 60+ stores near you, free."
>
  <div class="min-h-screen bg-[#0d9488] flex flex-col items-center justify-center px-6 py-16">

    <!-- Logo -->
    <a href="/" class="mb-10">
      <img src="/header-logo.png" alt="Cartana" class="h-10 w-auto brightness-0 invert" />
    </a>

    <!-- Card -->
    <div class="w-full max-w-sm bg-white rounded-3xl shadow-2xl shadow-black/20 p-8 text-center">

      <div class="inline-flex items-center gap-2 bg-teal-50 text-teal-700 text-xs font-semibold px-3 py-1.5 rounded-full mb-6 border border-teal-100">
        <span class="w-1.5 h-1.5 bg-teal-500 rounded-full animate-pulse"></span>
        2,400+ households on the waitlist
      </div>

      <h1 class="text-2xl font-bold text-slate-900 leading-tight mb-3">
        Get early access to<br />smarter grocery shopping.
      </h1>
      <p class="text-sm text-slate-500 leading-relaxed mb-7">
        Compare prices across 60+ stores near you. Know where to buy what's on your list — free, no sign-in required.
      </p>

      <!-- Sender.net form -->
      <div class="sender-form-field" data-sender-form-id="b4xo8x"></div>

      <p class="text-xs text-slate-400 mt-4">No spam. No credit card. Unsubscribe anytime.</p>
    </div>

    <!-- Trust line -->
    <p class="text-teal-100 text-xs mt-8 text-center">
      Privacy first — we never sell your data.
    </p>

  </div>
</Layout>
